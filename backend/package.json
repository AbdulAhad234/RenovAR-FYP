{
  "name": "renovar-backend",
  "version": "1.0.0",
  "description": "Backend API for RenovAR - AR-based interior design marketplace",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "set:role-claim": "node scripts/set-user-role-claim.js",
    "prepare:dataset": "node scripts/prepare-curated-dataset.js",
    "prepare:dataset:apply": "node scripts/prepare-curated-dataset.js --apply",
    "import:dataset": "node scripts/import-curated-dataset.js --manifest ../3D_Models_Dataset/curated-manifest.json --skip-duplicates",
    "import:dataset:dry-run": "node scripts/import-curated-dataset.js --manifest ../3D_Models_Dataset/curated-manifest.json --dry-run --skip-duplicates",
    "fix:dataset-assets": "node scripts/fix-assets-from-manifest.js --manifest ../3D_Models_Dataset/curated-manifest.json",
    "fix:dataset-assets:dry-run": "node scripts/fix-assets-from-manifest.js --manifest ../3D_Models_Dataset/curated-manifest.json --dry-run",
    "fix:dataset-assets:plan": "node scripts/fix-assets-from-manifest.js --manifest ../3D_Models_Dataset/curated-manifest.json --plan-only",
    "approve:vendor-products": "node scripts/auto-approve-products.js",
    "test": "jest",
    "lint": "eslint src/**/*.js"
  },
  "keywords": [
    "nodejs",
    "express",
    "firebase",
    "postgresql",
    "firestore",
    "aws-s3",
    "rest-api",
    "ar",
    "marketplace"
  ],
  "author": "RenovAR Team",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.400.0",
    "@aws-sdk/s3-request-presigner": "^3.1024.0",
    "@google-cloud/firestore": "^6.7.0",
    "axios": "^1.5.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "firebase-admin": "^11.11.1",
    "morgan": "^1.10.0",
    "pg": "^8.11.3",
    "psql": "^0.0.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
